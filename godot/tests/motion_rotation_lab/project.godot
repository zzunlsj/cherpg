; CheRPG standalone locomotion / direction-device lab. Godot 4.7.2
config_version=5

[application]
config/name="CheRPG | Canon Rules Motion Lab 0.0.8v"
run/main_scene="res://scenes/MotionLab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1400
window/size/viewport_height=860
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
